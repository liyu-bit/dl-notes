# 统一换行符为 LF，避免 Windows 下 diff 整个文件飘红
* text=auto eol=lf

# Markdown
*.md text diff=markdown
*.markdown text diff=markdown

# 代码
*.py text diff=python
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.json text eol=lf

# 笔记本
*.ipynb text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pt binary
*.pth binary
*.ckpt binary
*.npy binary
*.npz binary
*.h5 binary
